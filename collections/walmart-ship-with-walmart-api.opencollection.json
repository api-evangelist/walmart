              }
            ]
          },
          "docs": "This API retrieves all carriers supported by Ship With Walmart."
        },
        {
          "info": {
            "name": "Walmart Download Label",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-gateway.walmart.com/v3/shipping/labels/carriers/:carrierShortName/trackings/:trackingNo",
            "headers": [
              {
                "name": "WM_SEC.ACCESS_TOKEN",
                "value": "eyJraWQiOiIzZjVhYTFmNS1hYWE5LTQzM....."
              },
              {
                "name": "WM_CONSUMER.CHANNEL.TYPE",
                "value": ""
              },
              {
                "name": "WM_QOS.CORRELATION_ID",
                "value": "b3261d2d-028a-4ef7-8602-633c23200af6"
              },
              {
                "name": "WM_SVC.NAME",
                "value": "Walmart Service Name"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "carrierShortName",
                "value": "",
                "type": "path",
                "description": "carrierShortName"
              },
              {
                "name": "trackingNo",
                "value": "",
                "type": "path",
                "description": "trackingNo"
              }
            ]
          },
          "docs": "This API retrieves label for a carrier & tracking number combination.The response to a successful call contains the tracking number with the pdf or image type based on the media type passed in Accept header.\nFor eg. 'Accept'='application/json,application/pdf' will result in pdf media type and\n'Accept'='application/json,image/png' as image media type."
        },
        {
          "info": {
