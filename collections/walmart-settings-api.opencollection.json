          "info": {
            "name": "Walmart Get Shipping Template Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-gateway.walmart.com/v3/settings/shipping/templates/:templateId",
            "headers": [
              {
                "name": "WM_SEC.ACCESS_TOKEN",
                "value": "eyJraWQiOiIzZjVhYTFmNS1hYWE5LTQzM....."
              },
              {
                "name": "WM_CONSUMER.CHANNEL.TYPE",
                "value": ""
              },
              {
                "name": "WM_QOS.CORRELATION_ID",
                "value": "b3261d2d-028a-4ef7-8602-633c23200af6"
              },
              {
                "name": "WM_SVC.NAME",
                "value": "Walmart Service Name"
              }
            ],
            "params": [
              {
                "name": "templateId",
                "value": "",
                "type": "path",
                "description": "templateId"
              }
            ]
          },
          "docs": "Get Shipping Template Details. Details of CUSTOM, DEFAULT and 3PL-specific (eg. DELIVERR) templates can be retrieved through this API. 3PL will be able to see details of only 3PL-specific templates."
        },
