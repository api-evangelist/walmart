        {
          "id": "4913dbe3-b6a6-44b6-a35f-ce3c28a50110",
          "name": "Walmart Create Report Request",
          "request": {
            "name": "Walmart Create Report Request",
            "description": {
              "content": "<p style=\"color:red; font-size:larger\">POST <walmartAuthServerUrl>/v3/reports/reportRequest</p>\n\nThis request creates a new request for a report by specifying the report type and version. \n\nIn the request body, define one or more attributes to include in the report. \nThe attribute must be a valid attribute for the report. \nReference the guide for a list of applicable attributes in each report and definitions.\nSee the <a href=\"/doc/us/us-supplier/us-supplier-onrequestreports/\">On Request Reports</a> guide for more information. \n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "reports",
                "reportRequests"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "reportType",
                  "value": "<string>",
                  "description": "(Required) Specifies the report type for the request. \n\nFor example, `reportType=INVENTORY_DSV` creates an inventory report.\n\nValid values are: \n\n| Value | Meaning |\n| --- | --- |\n| INVENTORY_DSV | Creates an inventory report |\n| ITEM_CONFIGURATION_DATA | Creates an item configuration data report |\n\nExample(s):<br>\nINVENTORY_DSV<br>\nITEM_CONFIGURATION_DATA\n"
                },
                {
                  "disabled": false,
                  "key": "reportVersion",
                  "value": "<string>",
                  "description": "(Required) Specifies the version of the created report. \n\nSupported versions for each report type include: \n\n| Report Type | Supported Version |\n| --- | --- |\n| INVENTORY_DSV | v1 |\n| ITEM_CONFIGURATION_DATA | v1 |\n\nExample(s):<br>\nv1\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Specifies an identifier that tracks the consumer request by channel.\n\nUse the consumer channel type received during onboarding.\n\nSee the system administrator or developer management for the `WM_CONSUMER.CHANNEL.TYPE` value.\n",
                "key": "WM_CONSUMER.CHANNEL.TYPE",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Specifies an identifier for each API call and is used to track and debug issues.\n\n This may be any value, but cannot be null or omitted. \n",
                "key": "WM_QOS.CORRELATION_ID",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Specifies the access token retrieved in the <a href=\"https://developer.walmart.com/api/us/supplier/auth#operation/dsvTokenAPI\">Create Access Token</a> request.\n\nThis value is required for token-based authentication.\n",
                "key": "WM_SEC.ACCESS_TOKEN",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "applications/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rowFilters\": [\n    {\n      \"type\": \"<string>\",\n      \"columnName\": \"<string>\",\n      \"from\": \"<string>\",\n      \"to\": \"<string>\",\n      \"values\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    },\n    {\n      \"type\": \"<string>\",\n      \"columnName\": \"<string>\",\n      \"from\": \"<string>\",\n      \"to\": \"<string>\",\n      \"values\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    }\n  ],\n  \"includeColumns\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}"
