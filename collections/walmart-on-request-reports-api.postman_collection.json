                },
                {
                  "disabled": false,
                  "key": "requestStatus",
                  "value": "<string>",
                  "description": "Specifies the status of the report request. \n\nValid values include:\n\n| Value | Description |\n| --- | --- |\n| RECEIVED | Report request has been received |\n| INPROGRESS | Report request is in progress |\n| READY | Report request is ready |\n| ERROR | Report request is in an error state |\n\nExample(s):<br>\nRECEIVED\n"
                },
                {
                  "disabled": false,
                  "key": "requestSubmissionStartDate",
