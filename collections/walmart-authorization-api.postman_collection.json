          "name": "Walmart Token Api",
          "request": {
            "name": "Walmart Token Api",
            "description": {
              "content": "Get access token by providing Client ID and Client Secret.<br />An access token expires after a certain interval, so you will have to refresh a user's access token. You could use refresh token, obtained from the token API call using authorization code grant type, to get a new access token. Refresh tokens remain valid for a year.<br /><br /> [Guide reference - authorization_code](/doc/us/mp/us-mp-auth2/#606)<br /><br /> [Guide reference - refresh_token](/doc/us/mp/us-mp-auth2/#606)<br /><br /> [Guide reference - client_credentials](/doc/us/mp/us-mp-auth/#606)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Partner Id registered in Walmart marketplace to identify a seller. <br /> This field is required when **grant_type: authorization_code** and **grant_type: refresh_token**",
                "key": "WM_PARTNER.ID",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "A unique ID to track the consumer request by channel. Use the Consumer Channel Type received during onboarding.",
                "key": "WM_CONSUMER.CHANNEL.TYPE",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) A unique ID which identifies each API call and used to track and debug issues; use a random generated GUID for this ID",
                "key": "WM_QOS.CORRELATION_ID",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Walmart Service Name",
                "key": "WM_SVC.NAME",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
